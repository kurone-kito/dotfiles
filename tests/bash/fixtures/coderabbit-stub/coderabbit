#!/bin/sh
# Test-only stand-in for the coderabbit CLI. Each call appends one line to
# the record file and exits 127, so no test can reach the real CLI or the
# external service. teardown_suite() in setup_suite.bash fails the run when
# the record is not empty.
printf '%s\n' "$*" >> "${CODERABBIT_STUB_RECORD:-${BATS_SUITE_TMPDIR:?}/coderabbit-calls}"
exit 127
