{{- $gitName := promptStringOnce . "git.name" "Git user name" -}}
{{- $gitEmail := promptStringOnce . "git.email" "Git email address" -}}
{{- $gitSigningKey := promptStringOnce . "git.signingkey" "GPG signing key fingerprint (leave empty to disable signing)" -}}
{{- $secretManager := promptStringOnce . "secret.manager" "Secret manager (bitwarden, onepassword, keepassxc, local, none)" -}}

[data.git]
name = {{ $gitName | quote }}
email = {{ $gitEmail | quote }}
signingkey = {{ $gitSigningKey | quote }}
{{- if (dig "git" "signing_format" "" .) }}
signing_format = {{ dig "git" "signing_format" "" . | quote }}
{{- end }}
{{- range $key, $profile := (dig "git" "profiles" dict .) }}

[data.git.profiles."{{ $key }}"]
name = {{ $profile.name | quote }}
email = {{ $profile.email | quote }}
signingkey = {{ dig "signingkey" "" $profile | quote }}
gitdir = {{ $profile.gitdir | quote }}
{{- if (dig "signing_format" "" $profile) }}
signing_format = {{ dig "signing_format" "" $profile | quote }}
{{- end }}
{{- if (dig "sshhost" "" $profile) }}
sshhost = {{ dig "sshhost" "" $profile | quote }}
{{- end }}
{{- end }}

[data.secret]
manager = {{ $secretManager | quote }}
{{- if (dig "secret" "local_dir" "" .) }}
local_dir = {{ dig "secret" "local_dir" "" . | quote }}
{{- end }}
{{- range $key, $gpg := (dig "secret" "gpg" dict .) }}

[data.secret.gpg."{{ $key }}"]
item = {{ $gpg.item | quote }}
{{- end }}
{{- range $key, $sshKey := (dig "secret" "ssh" "keys" dict .) }}

[data.secret.ssh.keys."{{ $key }}"]
item = {{ $sshKey.item | quote }}
filename = {{ $sshKey.filename | quote }}
{{- if (dig "signing_fallback" false $sshKey) }}
signing_fallback = {{ dig "signing_fallback" false $sshKey }}
{{- end }}
{{- with (dig "signing_profiles" (list) $sshKey) }}
signing_profiles = [
  {{- range $idx, $name := . -}}
    {{- if $idx }}, {{ end -}}{{ $name | quote }}
  {{- end -}}
]
{{- end }}
{{- end }}
{{- range $key, $host := (dig "secret" "ssh" "hosts" dict .) }}

[data.secret.ssh.hosts."{{ $key }}"]
hostname = {{ $host.hostname | quote }}
user = {{ dig "user" "git" $host | quote }}
identity = {{ $host.identity | quote }}
{{- if (dig "port" 0 $host) }}
port = {{ dig "port" 0 $host }}
{{- end }}
{{- end }}
{{- range $key, $file := (dig "secret" "files" dict .) }}

[data.secret.files."{{ $key }}"]
item = {{ $file.item | quote }}
target = {{ $file.target | quote }}
{{- if (dig "attachment" "" $file) }}
attachment = {{ dig "attachment" "" $file | quote }}
{{- end }}
{{- end }}
{{- range $key, $clone := (dig "ghq" "clone" dict .) }}

[data.ghq.clone."{{ $key }}"]
owner = {{ $clone.owner | quote }}
token_item = {{ $clone.token_item | quote }}
{{- if (dig "hostname" "" $clone) }}
hostname = {{ dig "hostname" "" $clone | quote }}
{{- end }}
{{- if ne (dig "ssh" true $clone) true }}
ssh = {{ dig "ssh" true $clone }}
{{- end }}
{{- if (dig "mise_trust" false $clone) }}
mise_trust = {{ dig "mise_trust" false $clone }}
{{- end }}
{{- end }}
{{- /* Repo-shipped defaults for data.wingetUserPath.packages, merged
     under any user-declared entries of the same key (dst wins
     per-field via mergo/sprig merge, so overriding or disabling
     with enabled = false doesn't require restating id/bin).
     Mirrored in winget-user-path-packages.json.tmpl — keep both in
     sync. */ -}}
{{- $wingetDefaultPackages := dict
      "mise"    (dict "id" "jdx.mise" "bin" "mise/bin")
      "chezmoi" (dict "id" "twpayne.chezmoi")
      "ffmpeg"  (dict "id" "Gyan.FFmpeg" "bin" "ffmpeg-*-full_build/bin")
      "sqlite"  (dict "id" "SQLite.SQLite")
      "ngrok"   (dict "id" "Ngrok.Ngrok") -}}
{{- range $key, $pkg := (merge (dig "wingetUserPath" "packages" dict .) $wingetDefaultPackages) }}

[data.wingetUserPath.packages."{{ $key }}"]
id = {{ dig "id" "" $pkg | quote }}
{{- if (dig "bin" "" $pkg) }}
bin = {{ dig "bin" "" $pkg | quote }}
{{- end }}
{{- if not (dig "enabled" true $pkg) }}
enabled = {{ dig "enabled" true $pkg }}
{{- end }}
{{- end }}
{{- $sshServer := dig "ssh" "server" dict . }}
{{- if $sshServer }}

[data.ssh.server]
{{- if ne (dig "clientAliveInterval" 300 $sshServer) 300 }}
clientAliveInterval = {{ dig "clientAliveInterval" 300 $sshServer }}
{{- end }}
{{- if ne (dig "clientAliveCountMax" 5 $sshServer) 5 }}
clientAliveCountMax = {{ dig "clientAliveCountMax" 5 $sshServer }}
{{- end }}
{{- if (dig "defaultShell" "" $sshServer) }}
defaultShell = {{ dig "defaultShell" "" $sshServer | quote }}
{{- end }}
{{- if (dig "defaultShellFallbackToLegacy" false $sshServer) }}
defaultShellFallbackToLegacy = {{ dig "defaultShellFallbackToLegacy" false $sshServer }}
{{- end }}
{{- end }}
{{- $tmpfilesAge := dig "tmpfiles" "age" "10d" . }}
{{- if ne $tmpfilesAge "10d" }}

[data.tmpfiles]
age = {{ $tmpfilesAge | quote }}
{{- end }}
{{- $mkcertInstall := dig "mkcert" "install" false . }}
{{- if $mkcertInstall }}

[data.mkcert]
install = {{ $mkcertInstall }}
{{- end }}
{{- range $key, $entry := (dig "env" "deploy" dict .) }}

[data.env.deploy."{{ $key }}"]
repo = {{ $entry.repo | quote }}
item = {{ $entry.item | quote }}
{{- if (dig "filename" "" $entry) }}
filename = {{ dig "filename" "" $entry | quote }}
{{- end }}
{{- if (dig "subpath" "" $entry) }}
subpath = {{ dig "subpath" "" $entry | quote }}
{{- end }}
{{- if (dig "attachment" "" $entry) }}
attachment = {{ dig "attachment" "" $entry | quote }}
{{- end }}
{{- end }}

# Optional [data.*] sections below extend what the prompts above collect.
# Field-by-field schema, defaults, and a complete worked example for every
# section live in docs/chezmoi-toml-reference.md; this block only calls
# out live template/script *behavior* not captured by that schema
# reference, with a pointer to the matching anchor and deployment guide
# for the full shape.
#
# Directory-specific Git profiles ([data.git.profiles.<label>]):
# docs/chezmoi-toml-reference.md#git-identity-datagit-datagitprofileslabel
# and docs/secret-manager-setup.md.
#
# Secret manager ([data.secret], [data.secret.gpg/.ssh.keys/.ssh.hosts/.files]):
# docs/chezmoi-toml-reference.md#secret-manager-datasecret (see that page
# for the per-subsection anchors) and docs/secret-manager-setup.md for the
# setup walkthrough, the SSH commit-signing fallback
# (signing_fallback / signing_profiles / signing_format) resolution order
# and validation, and the manager = "local" directory layout
# (<local_dir>/<item>/<param>).
#
# Bulk repo cloning ([data.ghq.clone.<label>]):
# docs/chezmoi-toml-reference.md#bulk-repo-cloning-dataghqclonelabel and
# docs/ghq-workflow.md.
#
# WinGet User PATH packages ([data.wingetUserPath.packages.<label>]):
# docs/chezmoi-toml-reference.md#winget-user-path-packages-datawingetuserpathpackageslabel
# and docs/winget-user-path.md. `bin` may contain one `*` wildcard path
# segment (e.g. "ffmpeg-*-full_build/bin"); when more than one directory
# matches, the lexicographically last one (plain string sort) wins.
#
# SSH server hardening ([data.ssh.server]):
# docs/chezmoi-toml-reference.md#ssh-server-hardening-datasshserver and
# docs/sshd-config-setup.md. defaultShell drives
# set-openssh-default-shell.ps1's bare-invocation resolution: absent is a
# no-op; "cmd" removes the DefaultShell registry values;
# "legacy-powershell"/"modern-powershell" resolve powershell.exe/pwsh.exe
# (fails loudly unless defaultShellFallbackToLegacy = true lets
# "modern-powershell" fall back). This registry change stays manual and
# elevated -- chezmoi never applies it automatically.
#
# systemd-tmpfiles /tmp cleanup age ([data.tmpfiles]):
# docs/chezmoi-toml-reference.md#systemd-tmpfiles-cleanup-age-datatmpfilesage
# and docs/tmpfiles-cleanup-setup.md. Linux-only; the generated file is a
# staging copy at ~/.config/tmpfiles.d/tmp.conf, deployed to
# /etc/tmpfiles.d/tmp.conf manually.
#
# mkcert local CA ([data.mkcert]):
# docs/chezmoi-toml-reference.md#mkcert-local-ca-datamkcertinstall and
# docs/mkcert-local-ca.md. Windows-only; runs `mkcert -install` during
# `chezmoi apply`.
#
# .env deployment ([data.env.deploy.<label>]) and user-global secret files
# ([data.secret.files.<label>]):
# docs/chezmoi-toml-reference.md#env-deployment-dataenvdeploylabel and
# #secret-files-datasecretfileslabel, plus docs/secret-manager-setup.md.
# Both deploy with mode 600 (Linux/macOS) / user-only ACL (Windows); the
# env deploy script also warns when the target project's .gitignore is
# missing the deployed filename, and multiple entries for the same repo
# are supported. Target paths are home-relative, forward-slash-separated,
# and must not contain "..".
#
# Zellij Web ([data.zellij], [data.zellij.web], [data.zellij.web.tailscale],
# [data.zellij.web.windows/.linux/.macos]):
# docs/chezmoi-toml-reference.md#zellij-web-datazellij-datazellijweb and
# the "Zellij Web" section of README.md -- full schema, example, and
# autostart/tailscale deployment steps for each OS.
