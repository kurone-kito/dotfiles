{
  "$schema": "https://kurone-kito.github.io/idd-skill/schemas/policy.schema.json",
  "iddVersion": "0.12.2",
  "markerPrefix": "dotfiles",
  "developmentBranch": "master",
  "mergePolicy": "fully_autonomous_merge",
  "mergePolicyAck": "fully_autonomous_merge",
  "reviewPolicy": "copilot-advisory",
  "threadResolutionPolicy": "fast-agent-resolve",
  "authoringLanguage": "en",
  "claimTiming": {
    "staleAge": "PT12H",
    "heartbeatInterval": "PT6H"
  },
  "forcedHandoff": {
    "mode": "human-gated",
    "authorityPolicy": "owners-and-maintainers-only"
  },
  "trustedMarkerActors": [
    "kurone-kito"
  ],
  "advisoryBotLogins": [
    "copilot-pull-request-reviewer[bot]",
    "coderabbitai[bot]",
    "chatgpt-codex-connector[bot]"
  ],
  "workshop": {
    "exampleRepository": ""
  },
  "commands": {
    "install-deps": "git submodule update --init --recursive",
    "fix-validate": "npx markdownlint-cli2 --fix && npx markdownlint-cli2 && npx cspell lint \"**\" --no-progress",
    "pre-push-validate": "scripts/run-validate.sh",
    "post-fix-validate": "scripts/run-validate.sh"
  },
  "helperRuntime": {
    "profile": "ephemeral-npx",
    "packageSpec": "https://codeload.github.com/kurone-kito/idd-skill/tar.gz/c11c3642319b3283293e4e681861bf7899c32ed3"
  },
  "issueScope": "roadmap-first",
  "orphanFirstPolicy": "none",
  "discover": {
    "selectionDesync": "session-offset"
  },
  "advisoryWait": {
    "convergenceScope": "idd-claimed",
    "convergenceDeadline": "PT9H",
    "secondaryQuietWindow": "PT1H",
    "secondaryBotLogin": "coderabbitai[bot]"
  },
  "ciWait": {
    "runningTimeout": "PT10M",
    "generationTimeout": "PT10M",
    "rerunPolicy": "rerun-once"
  },
  "ciGate": {
    "externalChecks": {
      "waivable": [
        { "selector": "idd-advisory-convergence", "matchMode": "exact" }
      ]
    },
    "externalCheckWaivers": {
      "mode": "maintainer-authorized",
      "authorityPolicy": "owners-and-maintainers-only",
      "maxValidity": "PT24H"
    },
    "trustSourcePinnedRequiredChecks": true,
    "trustEmptyProtectionReads": true
  },
  "providerOutage": {
    "declarationTarget": 393
  },
  "skipIssueAuthorApprovalGate": true,
  "maintainerApprovalActorPolicy": "owners-and-maintainers-only",
  "autopilotSuitability": {
    "floor": 3
  },
  "critiqueLoop": {
    "deferAfterRounds": 5,
    "delegate": {
      "command": "coderabbit-critique",
      "mode": "combined"
    },
    "telemetryHook": {
      "command": "idd-critique-telemetry"
    }
  },
  "worktreeGuard": {
    "enabled": true,
    "refuseBaseBranchCommits": true
  },
  "issueAuthoring": {
    "journalIssue": "kurone-kito/dotfiles#380"
  },
  "labels": {
    "untrustedLabelerLogins": [
      "coderabbitai[bot]"
    ]
  },
  "upstreamEscalation": {
    "enabled": true
  }
}
