{{- /* When syncing shared guidance, preserve this compact default and the
     true opt-in, then verify both OpenCode renders and peer-agent outputs. */ -}}
{{- $opencode := dig "opencode" dict . -}}
{{- $extendedInstructions := false -}}
{{- if kindIs "map" $opencode -}}
{{-   if hasKey $opencode "extendedInstructions" -}}
{{-     $value := get $opencode "extendedInstructions" -}}
{{-     if kindIs "bool" $value -}}
{{-       $extendedInstructions = $value -}}
{{-     else -}}
{{-       warnf "data.opencode.extendedInstructions must be true or false; using compact OpenCode instructions" -}}
{{-     end -}}
{{-   end -}}
{{- else -}}
{{-   warnf "data.opencode is not a table; using compact OpenCode instructions" -}}
{{- end -}}
{{- if $extendedInstructions -}}
{{- template "ai-agent-user-global" (dict
  "agent" "OpenCode"
  "path" "~/.config/opencode/AGENTS.md"
  "breakBeforeFrom" false
  "precedenceTail" " If a repository\nprovides its own `AGENTS.md`, follow those rules wherever they differ\nfrom or extend this file. OpenCode's Plan and Build modes follow the\nshared conversation rule: continue autonomously for low-risk work, and\npause to ask when uncertainty or hidden risk makes the next step unsafe."
  "memoryNote" false
  "copilotConversation" false
  "noTtyPrecheck" true
  "copilotKeyDiscovery" false
  "signingMark" "*") -}}
{{- else -}}
{{- template "opencode-compact-instructions" . -}}
{{- end -}}
