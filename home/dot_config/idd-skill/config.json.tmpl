{{/*
User-global IDD critique-loop delegate and telemetry-hook configuration,
read by an IDD session's C1 phase from $XDG_CONFIG_HOME/idd-skill/config.json
(falling back to $HOME/.config/idd-skill/config.json), per idd-skill's
documented path/fallback rule. A repository-local critiqueLoop.delegate or
critiqueLoop.telemetryHook always overrides its own key here when present --
each fragment only takes effect for a repository whose own
.github/idd/config.json leaves that same key entirely unset.

mode: "combined" runs both this delegate and the per-agent critique
mechanism every C1 pass and unions their findings, rather than only
falling back to the per-agent mechanism when this delegate fails --
maximizing what is caught before a PR opens.

critiqueLoop.telemetryHook is a separate, fire-and-forget per-round
observability sink (see docs/idd-workflow.md's "User-global critique
telemetry hook default" section) -- it never supplies critique findings
and never gates C-phase control flow, unlike the delegate above.
*/ -}}
{{- $home := .chezmoi.homeDir -}}
{{- $sep := "/" -}}
{{- if eq .chezmoi.os "windows" }}{{ $sep = "\\" }}{{ end -}}
{{/* Prefer pwsh (PowerShell 7+), but a supported Windows machine may
     have only the built-in Windows PowerShell 5.1 -- every launcher
     script referenced below is PS5.1-compatible, so fall back to
     powershell.exe rather than rendering a command that can never be
     found there. Resolved once and shared by every Windows-branch
     binary below. */ -}}
{{- $shell := "pwsh" -}}
{{- if and (eq .chezmoi.os "windows") (not (lookPath "pwsh")) -}}
{{-   $shell = "powershell.exe" -}}
{{- end -}}
{{/* Shared templated-path/shell-quoting construction for a
     ~/.local/bin/<binary-name> command, parameterized by binary name so
     critiqueLoop.delegate and critiqueLoop.telemetryHook below render
     from the exact same logic instead of two hand-duplicated copies. */ -}}
{{- $binCommand := dict -}}
{{- range $bin := list "coderabbit-critique" "idd-critique-telemetry" -}}
{{-   $unixPath := printf "%s%s.local%sbin%s%s" $home $sep $sep $sep $bin -}}
{{/*   critiqueLoop.*.command is run as a shell command (see
       docs/idd-workflow.md's Critique pass invocation section), so the
       path itself needs POSIX shell quoting, not just JSON-safe text --
       toPrettyJson only escapes for JSON, and a $home containing a space
       or other shell metacharacter would otherwise be split/expanded
       into multiple words. squote does not escape an embedded single
       quote, so build the standard '...'\''...' POSIX escape by hand. */ -}}
{{-   $command := printf "'%s'" (replace "'" "'\\''" $unixPath) -}}
{{-   if eq $.chezmoi.os "windows" -}}
{{-     $psPath := printf "%s%s.local%sbin%s%s.ps1" $home $sep $sep $sep $bin -}}
{{-     $command = printf "%s -NoProfile -File \"%s\"" $shell $psPath -}}
{{-   end -}}
{{-   $binCommand = set $binCommand $bin $command -}}
{{- end -}}
{{- $config := dict
      "critiqueLoop" (dict
        "delegate" (dict
          "command" (get $binCommand "coderabbit-critique")
          "mode" "combined")
        "telemetryHook" (dict
          "command" (get $binCommand "idd-critique-telemetry"))) -}}
{{ $config | toPrettyJson }}
