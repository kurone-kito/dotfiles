{{/*
User-global IDD critique-loop delegate configuration, read by an IDD
session's C1 phase from $XDG_CONFIG_HOME/idd-skill/config.json (falling
back to $HOME/.config/idd-skill/config.json), per idd-skill's documented
path/fallback rule. A repository-local delegate always overrides this
when present -- this file only takes effect for a repository whose own
.github/idd/config.json leaves critiqueLoop.delegate entirely unset.

mode: "combined" runs both this delegate and the per-agent critique
mechanism every C1 pass and unions their findings, rather than only
falling back to the per-agent mechanism when this delegate fails --
maximizing what is caught before a PR opens.
*/ -}}
{{- $home := .chezmoi.homeDir -}}
{{- $sep := "/" -}}
{{- if eq .chezmoi.os "windows" }}{{ $sep = "\\" }}{{ end -}}
{{- $command := printf "%s%s.local%sbin%s%s" $home $sep $sep $sep "coderabbit-critique" -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $psPath := printf "%s%s.local%sbin%s%s" $home $sep $sep $sep "coderabbit-critique.ps1" -}}
{{/* Prefer pwsh (PowerShell 7+), but a supported Windows machine may
     have only the built-in Windows PowerShell 5.1 -- the script itself
     is PS5.1-compatible, so fall back to powershell.exe rather than
     rendering a command that can never be found there. */ -}}
{{-   $shell := "pwsh" -}}
{{-   if not (lookPath "pwsh") -}}
{{-     $shell = "powershell.exe" -}}
{{-   end -}}
{{-   $command = printf "%s -NoProfile -File \"%s\"" $shell $psPath -}}
{{- end -}}
{{- $config := dict
      "critiqueLoop" (dict
        "delegate" (dict
          "command" $command
          "mode" "combined")) -}}
{{ $config | toPrettyJson }}
