# tmp.conf — generated by chezmoi.
# To modify, edit ~/.local/share/chezmoi/home/dot_config/tmpfiles.d/tmp.conf.tmpl
# and run `chezmoi apply`.
#
# This file is rendered to ~/.config/tmpfiles.d/tmp.conf (user level).
# It is an inert staging copy — it has no special meaning to any
# systemd instance. Deploy it to the system location manually:
#
#   sudo cp ~/.config/tmpfiles.d/tmp.conf /etc/tmpfiles.d/tmp.conf
#
# /etc/tmpfiles.d/tmp.conf MASKS (fully replaces, not merges with)
# /usr/lib/tmpfiles.d/tmp.conf — same filename in the higher-priority
# directory is systemd's documented override mechanism. Diff your own
# distro's shipped file first, since the exact ruleset can vary by
# distro/systemd version:
#
#   cat /usr/lib/tmpfiles.d/tmp.conf
#
# Because masking replaces the whole file, both shipped rules are
# reproduced below — only the /tmp age is parameterized. Do not deploy
# this under any name other than tmp.conf: a different name would add
# a second, independent /tmp rule alongside the shipped one instead of
# replacing it, causing duplicate/conflicting-rule warnings on every
# clean run.
#
# The /tmp age is quoted so a multi-component systemd time span (e.g.
# "1d 12h", which is valid systemd.time(7) syntax and contains a
# space) still parses as one field. An unquoted space would otherwise
# split into a second, unexpected token, and systemd-tmpfiles silently
# ignores the whole age argument on that line ("q lines don't take
# argument fields, ignoring"), falling back to its own built-in
# default instead of the configured age.
#
# The /var/tmp line below stays commented out by default, mirroring
# upstream systemd's own tmp.conf convention (observed shipped as
# `#q /var/tmp 1777 root root 30d` on Ubuntu 24.04) rather than
# unconditionally enabling /var/tmp cleanup: some distros ship /var/tmp
# cleanup already active (uncommented), others ship it inactive. Diff
# your own host's shipped file (previous section) to see which side of
# that split you're on, and uncomment the line below only if your
# shipped file already had it active — otherwise leave it commented so
# this override doesn't silently start deleting untouched /var/tmp
# contents that were never being cleaned before.
#
# See docs/tmpfiles-cleanup-setup.md for full deployment and rollback
# instructions.

q /tmp 1777 root root "{{ dig "tmpfiles" "age" "10d" . }}"
#q /var/tmp 1777 root root 30d
