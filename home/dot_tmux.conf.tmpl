# -*- mode: properties -*-
# vim: set ft=properties :

set-option -gw mode-keys vi

set -g default-terminal 'screen-256color'
set -q -g status-utf8 on
setw -q -g utf8 on

# start window numbers at 1 to match keyboard order with tmux window order
set -g base-index 1
setw -g pane-base-index 1
set -g renumber-windows on

# reload configuration
unbind r
bind r source-file ~/.tmux.conf

# increase scrollback lines
set -g history-limit 10000

setw -g mouse on

{{if eq .chezmoi.os "windows" -}}
# psmux's source-file does not support/strip tmux's -q flag (unlike
# real tmux), so this Windows branch guards the optional shared local
# override's existence directly instead of relying on -q to skip it
# silently.
if-shell 'Test-Path $HOME\.tmux.conf.local' 'source-file ~/.tmux.conf.local'
{{- else -}}
source-file -q ~/.tmux.conf.local
{{- end}}
