#!/bin/bash
# chezmoi run_onchange_after script: register pueued with the Linux user
# service manager. Re-runs when the autostart mode or the unit template changes.
# unit hash: {{ include "dot_config/systemd/user/pueued.service.tmpl" | sha256sum }}
# launchagent hash: {{ include "Library/LaunchAgents/com.kurone-kito.pueued.plist.tmpl" | sha256sum }}
set -euo pipefail

# See run_after_99-secret-status-summary.sh.tmpl for rationale.
exec </dev/null

{{ $linuxAutostart := dig "pueue" "linux" "autostart" "systemd-user" . -}}
{{ if not (or (eq $linuxAutostart "systemd-user") (eq $linuxAutostart "disabled")) -}}
{{   fail (printf "data.pueue.linux.autostart must be \"systemd-user\" or \"disabled\"; got %q" $linuxAutostart) -}}
{{ end -}}
linux_autostart="{{ $linuxAutostart }}"
{{ $macosAutostart := dig "pueue" "macos" "autostart" "launchagent" . -}}
{{ if not (or (eq $macosAutostart "launchagent") (eq $macosAutostart "disabled")) -}}
{{   fail (printf "data.pueue.macos.autostart must be \"launchagent\" or \"disabled\"; got %q" $macosAutostart) -}}
{{ end -}}
macos_autostart="{{ $macosAutostart }}"

dotfiles_user_systemd_available() {
  command -v systemctl >/dev/null 2>&1 \
    && systemctl --user show-environment >/dev/null 2>&1
}

pueued_probe() {
  # Prints running, none, or unknown. Unknown means the check could not run,
  # and the caller fails closed on it.
  if ! command -v pgrep >/dev/null 2>&1; then
    echo unknown
    return 0
  fi
  local status=0
  pgrep -u "$(id -u)" -x pueued >/dev/null 2>&1 || status=$?
  case "$status" in
    0) echo running ;;
    1) echo none ;;
    *) echo unknown ;;
  esac
}

register_linux_service() {
  # Validate the mode before any service manager call, so a typo fails loudly
  # on every host, with or without user systemd.
  case "$linux_autostart" in
    disabled|systemd-user) ;;
    *)
      echo "Unsupported data.pueue.linux.autostart mode: $linux_autostart" >&2
      return 1
      ;;
  esac

  case "$linux_autostart" in
    disabled)
      # Opt-out path: skip quietly when systemctl is missing or the user bus
      # does not answer, because there is nothing to disable there. A failing
      # disable is not hidden: set -e makes the script exit non-zero.
      if ! dotfiles_user_systemd_available; then
        echo "pueued user service not managed because user systemd is unavailable."
        return 0
      fi
      systemctl --user disable --now pueued.service
      echo "pueued user service disabled."
      ;;
    systemd-user)
      # Default-on path. A missing bus only warns: a host without user systemd
      # must not fail chezmoi apply. The pueued -d fallback in the wrapper
      # still covers that host.
      # chezmoi records a run_onchange script that exits 0, so these warnings
      # do not retry on the next apply. The warning names the manual command.
      if ! command -v systemctl >/dev/null 2>&1; then
        echo "warn: systemctl not found; pueued user service not registered. After installing systemd, run: systemctl --user enable --now pueued.service" >&2
        return 0
      fi
      if ! systemctl --user show-environment >/dev/null 2>&1; then
        echo "warn: user systemd is not available; pueued user service not registered. After enabling user systemd, run: systemctl --user enable --now pueued.service" >&2
        return 0
      fi
      # An unmanaged pueued (started by the validation wrapper) may already
      # hold the queue socket. An enabled unit cannot bind it and would
      # restart-loop, so stop here and name the handover. A check that cannot
      # run is unknown, and unknown fails closed the same way. Never stop a
      # running daemon from this script.
      case "$(pueued_probe)" in
        none) ;;
        *)
          if ! systemctl --user is-active --quiet pueued.service; then
            echo "warn: an unmanaged pueued may be running, or the check could not run; pueued user service not registered. To hand over, run: pueue shutdown, then: systemctl --user enable --now pueued.service" >&2
            return 0
          fi
          ;;
      esac
      systemctl --user daemon-reload
      systemctl --user enable pueued.service >/dev/null
      systemctl --user restart pueued.service
      if command -v loginctl >/dev/null 2>&1; then
        current_user="${USER:-$(id -un)}"
        linger="$(loginctl show-user "$current_user" -p Linger --value 2>/dev/null || true)"
        if [ "$linger" != "yes" ]; then
          echo "warn: linger not enabled; pueued will not survive logout or reboot without an interactive login." >&2
        fi
      fi
      echo "pueued user service enabled."
      ;;
  esac
}

register_macos_agent() {
  # Validate the mode before any launchctl call, the same as on Linux.
  case "$macos_autostart" in
    launchagent|disabled) ;;
    *)
      echo "Unsupported data.pueue.macos.autostart mode: $macos_autostart" >&2
      return 1
      ;;
  esac

  if ! command -v launchctl >/dev/null 2>&1; then
    echo "launchctl not found; pueued LaunchAgent not registered."
    return 0
  fi

  label="com.kurone-kito.pueued"
  plist="$HOME/Library/LaunchAgents/$label.plist"
  domain="gui/$(id -u)"

  case "$macos_autostart" in
    launchagent)
      # A missing plist is a failure, not a skip: chezmoi writes the plist
      # before this script runs. Each launchctl call stays plain, so set -e
      # stops at the first failure and the later steps do not run.
      if [ ! -f "$plist" ]; then
        echo "LaunchAgent plist not found: $plist" >&2
        return 1
      fi
      # The same guard as on Linux. An unmanaged pueued may already hold the
      # queue socket, and a loaded KeepAlive job would then restart-loop. A
      # label that is already loaded is ours, so it proceeds. Otherwise an
      # unmanaged or unknown probe skips the registration and names the
      # handover. The script never stops a running daemon.
      case "$(pueued_probe)" in
        none) ;;
        *)
          if ! launchctl print "$domain/$label" >/dev/null 2>&1; then
            echo "warn: an unmanaged pueued may be running, or the check could not run; pueued LaunchAgent not registered. To hand over, run: pueue shutdown, then: launchctl bootstrap $domain $plist" >&2
            return 0
          fi
          ;;
      esac
      launchctl enable "$domain/$label"
      if launchctl print "$domain/$label" >/dev/null 2>&1; then
        launchctl bootout "$domain/$label"
      fi
      launchctl bootstrap "$domain" "$plist"
      echo "pueued LaunchAgent loaded."
      ;;
    disabled)
      # Both steps run even when disable fails, so a failed disable still
      # unloads the session. A bootout failure counts only while the label is
      # still loaded: a label that is not loaded counts as success.
      disable_status=0
      bootout_failed=0
      launchctl disable "$domain/$label" || disable_status=$?
      if ! launchctl bootout "$domain/$label"; then
        if launchctl print "$domain/$label" >/dev/null 2>&1; then
          bootout_failed=1
        fi
      fi
      if [ "$disable_status" -ne 0 ] || [ "$bootout_failed" -ne 0 ]; then
        echo "pueued LaunchAgent disable did not complete; rerun the register script." >&2
        return 1
      fi
      echo "pueued LaunchAgent disabled."
      ;;
  esac
}

case "$(uname -s)" in
  Linux)
    register_linux_service
    ;;
  Darwin)
    register_macos_agent
    ;;
  *)
    echo "pueued registration is not managed on this platform."
    ;;
esac
