#!/bin/sh
# Emit CodeRabbit CLI's structured findings for the current branch diff, for
# use as an IDD C1 critiqueLoop.delegate command. Read-only findings adapter
# only: never fixes, commits, or retries -- C2-C6 own that. Fails (non-zero
# exit) whenever the caller should fall through to the per-agent critique
# mechanism instead: coderabbit missing, unauthenticated, no bounded way to
# run it, or an action_required response (rate limit / usage confirmation)
# that only the operator can resolve.
#
# `coderabbit review --agent` does not fail fast when unauthenticated -- it
# hangs waiting on an interactive browser OAuth flow instead of exiting, so
# authentication is checked up front via `coderabbit auth status` (which
# never hangs and always exits 0 regardless of sign-in state -- its text
# output must be parsed instead).
set -eu

# 300s default: an empirically observed real review of a 5-file diff took
# ~151s end to end (connect, setup, summarize, review); 120s was measured
# to be too short and cut a genuine in-progress review off mid-flight.
TIMEOUT_SECONDS="${CODERABBIT_CRITIQUE_TIMEOUT:-300}"
case "$TIMEOUT_SECONDS" in
  '' | *[!0-9]*) TIMEOUT_SECONDS=300 ;;
  *) [ "$TIMEOUT_SECONDS" -gt 0 ] 2>/dev/null || TIMEOUT_SECONDS=300 ;;
esac

if ! command -v coderabbit >/dev/null 2>&1; then
  echo "coderabbit not found in PATH" >&2
  exit 1
fi

# `command -v` only checks that a `timeout`/`gtimeout` binary exists, not
# that it understands the GNU-specific `--kill-after` option this script
# invokes it with (e.g. BusyBox's minimal `timeout` applet lacks it) -- a
# child that ignores SIGTERM would then survive past the bound. Probe
# --help output for the exact flag string this script invokes with (see
# ~/.gnupg/pinentry-auto's `timeout_cmd_is_compatible` for the identical
# pattern and its rationale). Unlike pinentry-auto -- which falls back to
# unbounded exec because an interactive human is normally present to
# eventually answer -- this script fails closed when no compatible timeout
# is found: it runs unattended, and the exact hang this bounds (an
# unauthenticated coderabbit call blocking on browser OAuth) has no human
# present to rescue it.
timeout_cmd_is_compatible() {
  help_output=$("$1" --help 2>&1)
  case "$help_output" in
    *--kill-after*) return 0 ;;
    *) return 1 ;;
  esac
}

TIMEOUT_CMD=""
if command -v timeout >/dev/null 2>&1 && timeout_cmd_is_compatible timeout; then
  TIMEOUT_CMD="timeout"
elif command -v gtimeout >/dev/null 2>&1 && timeout_cmd_is_compatible gtimeout; then
  TIMEOUT_CMD="gtimeout"
fi

if [ -z "$TIMEOUT_CMD" ]; then
  echo "coderabbit-critique: no timeout/gtimeout with --kill-after found; failing closed rather than risking an unbounded hang" >&2
  exit 1
fi

# The action_required guard below matches its literal via `grep -E`
# instead of a bare `case` (see the comment at the match site for why).
# `grep`'s own absence must not be misread as "no marker present" -- the
# exact failure this whole guard exists to prevent -- so it is checked
# explicitly up front, before any output exists to examine. This check is
# genuinely load-bearing rather than a nicety: the match itself has to
# run inside an `if grep ...; then` condition, which `set -e` does not
# cover (POSIX exempts commands in an `if` condition from triggering
# it), so without this preflight a missing `grep` there would silently
# read as "no match" -- the identical blind spot the existing `grep -q`
# rejection below already describes.
if ! command -v grep >/dev/null 2>&1; then
  echo "coderabbit-critique: grep not found; failing closed rather than risking an unmatched action_required marker" >&2
  exit 1
fi

auth_status="$(coderabbit auth status 2>&1 || true)"
case "$auth_status" in
  *"signed out"*)
    echo "coderabbit is not authenticated (run: coderabbit auth login)" >&2
    exit 1
    ;;
esac

# A hardcoded default branch name would be wrong for any repository that
# does not use it (this delegate is user-global, not dotfiles-specific).
# Prefer the remote's actual recorded default; fall back to checking common
# candidate names only if that is unset (e.g. `git remote set-head origin
# -a` was never run); fail closed rather than guessing wrong and silently
# diffing against a nonexistent or unintended base.
BASE_BRANCH="${CODERABBIT_CRITIQUE_BASE:-}"
if [ -z "$BASE_BRANCH" ]; then
  BASE_BRANCH="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')"
fi
if [ -z "$BASE_BRANCH" ]; then
  # A first-match loop would silently pick "main" over "master" whenever
  # a repository happens to have both remote-tracking refs (a rename in
  # progress, a stale branch left over, etc.) even if the real default is
  # "master" -- fail closed on that ambiguity instead of guessing.
  main_exists=false
  master_exists=false
  git rev-parse --verify --quiet origin/main >/dev/null && main_exists=true
  git rev-parse --verify --quiet origin/master >/dev/null && master_exists=true
  if [ "$main_exists" = true ] && [ "$master_exists" = false ]; then
    BASE_BRANCH=main
  elif [ "$master_exists" = true ] && [ "$main_exists" = false ]; then
    BASE_BRANCH=master
  fi
fi
if [ -z "$BASE_BRANCH" ]; then
  echo "coderabbit-critique: could not determine the default base branch (no origin/HEAD symref, no origin/main or origin/master); set CODERABBIT_CRITIQUE_BASE explicitly" >&2
  exit 1
fi

# stdout and stderr are captured separately (stderr via a temp file) so a
# clean run's own stdout carries only the reviewed process's findings --
# a progress line or diagnostic written to stderr must never reach C1 as
# findings text, where C3 could score it as a real issue. `mktemp` is
# already an accepted dependency in this repo's shell scripts (see
# secret-deploy-state); failing to create it fails closed rather than
# falling back to a merged capture that would reintroduce the leak this
# split exists to close.
stderr_tmp="$(mktemp "${TMPDIR:-/tmp}/coderabbit-critique-stderr.XXXXXX")" || {
  echo "coderabbit-critique: mktemp failed; cannot separate stdout from stderr" >&2
  exit 1
}
trap 'rm -f "$stderr_tmp"' EXIT

set +e
stdout_output="$("$TIMEOUT_CMD" --kill-after 2 "$TIMEOUT_SECONDS" coderabbit review --agent --base "$BASE_BRANCH" 2>"$stderr_tmp")"
status=$?
set -e
stderr_output="$(cat "$stderr_tmp")"

if [ "$status" -ne 0 ]; then
  echo "coderabbit review failed or timed out (exit $status)" >&2
  printf '%s\n' "$stdout_output" >&2
  printf '%s\n' "$stderr_output" >&2
  exit 1
fi

# `grep -E` rather than a bare `case`: `coderabbit review --agent`'s
# serialization is not a pinned contract, so a pretty-printer emitting
# whitespace around the key, the colon, or the value (e.g.
# `"type": "action_required"`) must still be caught, and a `case` glob
# cannot express "zero or more whitespace characters" without either
# over-matching (a wildcard would also swallow unrelated text between the
# tokens, risking a false positive against, say, a finding whose own
# message quotes that exact literal as an example) or enumerating a
# handful of specific whitespace-run lengths, which is not robust. A
# narrowly-scoped extended regex expresses the requirement precisely
# without mutating the text at all, so it cannot fuse unrelated tokens
# together the way a whitespace-stripping normalization pass could.
# `grep`'s own absence was already turned into a fail-closed exit above,
# so using it here for the match itself does not reopen the failure mode
# the original `grep -q` rejection describes.
#
# Both streams are scanned independently (not concatenated) because the
# emission point is unverified; scanning both keeps today's detection
# reach even though only stdout is emitted as findings below. Checking
# them independently rather than joined also avoids a false match built
# from a token split across the stream boundary -- a real marker write is
# atomic to one fd anyway, so this loses no genuine positive.
action_required_pattern='"type"[[:space:]]*:[[:space:]]*"action_required"'
action_required=false
if printf '%s' "$stdout_output" | grep -Eq -- "$action_required_pattern"; then
  action_required=true
elif printf '%s' "$stderr_output" | grep -Eq -- "$action_required_pattern"; then
  action_required=true
fi

if [ "$action_required" = true ]; then
  echo "coderabbit review requires operator action; treating as unavailable" >&2
  printf '%s\n' "$stdout_output" >&2
  printf '%s\n' "$stderr_output" >&2
  exit 1
fi

if [ -n "$stderr_output" ]; then
  printf '%s\n' "$stderr_output" >&2
fi
printf '%s\n' "$stdout_output"
