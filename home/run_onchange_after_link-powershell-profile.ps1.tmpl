# chezmoi:template:left-delimiter=<% right-delimiter=%>
<%- if eq .chezmoi.os "windows" %>
# Create profile loaders at all possible $PROFILE locations.
# Handles OneDrive redirection, localized Documents folder names,
# and VS Code host-specific profiles by writing shims to every
# known profile path.
#
# Load once per startup: profile.ps1 sources the config profile and then
# sets $global:IddPwshProfileLoaded. The host shims return early when that
# variable is set, so ConsoleHost (which runs both the AllHosts and the
# CurrentHost profile) sources the config profile once. The variable is a
# PowerShell global, not an environment variable, so child processes do not
# inherit it.
#
# hash: <% include "dot_config/powershell/profile.ps1" | sha256sum %>

# Test seam: a non-empty list replaces the Documents-based profile roots.
param([string[]]$ProfileRoot = @())

# CurrentUserAllHosts (profile.ps1). Sets the marker only after the source.
$loaderAllHosts = @'
# Auto-generated by chezmoi — do not edit directly.
# Real profile: ~/.config/powershell/profile.ps1
$configProfile = Join-Path (Join-Path (Join-Path $HOME '.config') 'powershell') 'profile.ps1'
if (Test-Path $configProfile) { . $configProfile }
$global:IddPwshProfileLoaded = $true
'@

# CurrentUserCurrentHost and VS Code host shims. Skipped when already loaded.
$loaderHost = @'
# Auto-generated by chezmoi — do not edit directly.
# Real profile: ~/.config/powershell/profile.ps1
if ((Get-Variable -Name 'IddPwshProfileLoaded' -Scope Global -ValueOnly -ErrorAction SilentlyContinue) -eq $true) { return }
$configProfile = Join-Path (Join-Path (Join-Path $HOME '.config') 'powershell') 'profile.ps1'
if (Test-Path $configProfile) { . $configProfile }
$global:IddPwshProfileLoaded = $true
'@

# Name-to-text mapping, applied under both PowerShell and WindowsPowerShell.
$loaderTexts = [ordered]@{
  'profile.ps1'                      = $loaderAllHosts
  'Microsoft.PowerShell_profile.ps1' = $loaderHost
  'Microsoft.VSCode_profile.ps1'     = $loaderHost
}

# Hard-link count of an existing file, read without following links.
# fsutil fails on a directory or a non-NTFS volume; the caller refuses then.
function Get-ShimHardLinkCount {
  param([string]$Path)
  $output = @(& fsutil hardlink list $Path 2>$null)
  if ($LASTEXITCODE -ne 0) { throw "hard-link count unavailable: $Path" }
  return @($output | Where-Object { "$_".Trim() -ne '' }).Count
}

# Resolve the roots: explicit test roots, or the Documents-based defaults.
if ($ProfileRoot.Count -gt 0) {
  $roots = @($ProfileRoot)
} else {
  # Collect all unique Documents base paths
  $docsPaths = @([Environment]::GetFolderPath('MyDocuments'))
  $homeDocs = Join-Path $HOME 'Documents'
  if (($homeDocs -ne $docsPaths[0]) -and (Test-Path $homeDocs)) {
    $docsPaths += $homeDocs
  }
  $roots = @()
  foreach ($docsBase in $docsPaths) {
    foreach ($subDir in @('PowerShell', 'WindowsPowerShell')) {
      $roots += Join-Path $docsBase $subDir
    }
  }
}

$failed = $false
foreach ($root in $roots) {
  try {
    if (-not (Test-Path -LiteralPath $root)) {
      New-Item -ItemType Directory -Force -Path $root -ErrorAction Stop | Out-Null
    }
  } catch {
    Write-Warning "Profile directory not created: $root ($($_.Exception.Message))"
    $failed = $true
    continue
  }
  foreach ($name in $loaderTexts.Keys) {
    $profilePath = Join-Path $root $name
    try {
      $existing = Get-Item -LiteralPath $profilePath -Force -ErrorAction SilentlyContinue
      if ($null -ne $existing) {
        if ($existing.LinkType -eq 'SymbolicLink' -or $existing.LinkType -eq 'Junction') {
          throw "refusing to write through a $($existing.LinkType)"
        }
        if ((Get-ShimHardLinkCount -Path $profilePath) -ne 1) {
          throw 'refusing to write: hard-link count is not exactly one'
        }
      }
      Set-Content -LiteralPath $profilePath -Value $loaderTexts[$name] -Force -ErrorAction Stop
      Write-Host "Profile loader created: $profilePath"
    } catch {
      Write-Warning "Profile loader not written: $profilePath ($($_.Exception.Message))"
      $failed = $true
    }
  }
}
if ($failed) { exit 1 }
<% end -%>
